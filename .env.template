# SMS API Environment Variables Template
# Copy this file and rename to .env.local (for local development)
# DO NOT commit files with actual values to source control

# =============================================================================
# IMPORTANT: This file is a TEMPLATE only
# Set these as actual environment variables on your system
# =============================================================================

# Environment Selection
# Options: Development, Staging, Production
ASPNETCORE_ENVIRONMENT=Production

# Database Configuration
# Replace with your actual connection string
SMS_ConnectionStrings__MasterDatabase=Data Source=YOUR_SERVER;Initial Catalog=SMS;User Id=YOUR_USER;Password=YOUR_PASSWORD;MultipleActiveResultSets=True;TrustServerCertificate=True;

# JWT Configuration
# Generate a secure key using: openssl rand -base64 32
SMS_Jwt__Key=YOUR_BASE64_ENCODED_SECRET_KEY_HERE
SMS_Jwt__Issuer=SMS
SMS_Jwt__Audience=SMS
SMS_Jwt__Subject=JWTServiceAccessToken

# File Storage Configuration
# Windows Example: C:\inetpub\wwwroot\SMS_GUI\brower\uploads\nic
# Linux Example: /var/www/sms/uploads/nic
SMS_FileSettings__NicUploadFolderPath=YOUR_UPLOAD_PATH_HERE

# =============================================================================
# HOW TO SET THESE VARIABLES
# =============================================================================

# WINDOWS (PowerShell - User Level):
# setx SMS_ConnectionStrings__MasterDatabase "YourConnectionString"
# setx SMS_Jwt__Key "YourBase64Key"

# WINDOWS (PowerShell - System Level, requires admin):
# setx SMS_ConnectionStrings__MasterDatabase "YourConnectionString" /M
# setx SMS_Jwt__Key "YourBase64Key" /M

# LINUX/macOS (add to ~/.bashrc or ~/.zshrc):
# export SMS_ConnectionStrings__MasterDatabase="YourConnectionString"
# export SMS_Jwt__Key="YourBase64Key"

# Then reload: source ~/.bashrc

